# ── Jetson GPU variant ──────────────────────────────────────────────
# Base: JP6.1 uses the pinned planar-navigation base; JP5.11 falls back to
# jetson-base and builds the same locked navigation overlay in this file.
#
# All cards share this image and the framework's CUDA torch / source ROS base.
# Planar navigation adds an overlay; it does not install a second ROS distro.
#
# Build context: repo root (phanthymotus/) so we can access both
# actucore/ and deploy/ros-base/audio_msgs/
#
# Usage:
#   ./deploy/build_actucore.sh --mirror tuna
# ────────────────────────────────────────────────────────────────────

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG JP_VERSION=511
ARG ACTUCORE_PARENT_IMAGE=bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp${JP_VERSION}-torch
FROM ${ACTUCORE_PARENT_IMAGE}
ARG PYPI_MIRROR APT_MIRROR
ARG BUILD_JOBS=2
ARG GIT_MIRROR_PREFIX=
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY actucore/plugins/planar_navigation/sources.lock actucore/plugins/planar_navigation/build-dependencies.sh /tmp/planar-build/
RUN set -e; if [ -e /opt/actucore_navigation_ws/sources.lock ]; then \
      cmp -s /tmp/planar-build/sources.lock /opt/actucore_navigation_ws/sources.lock || \
        { echo 'ERROR=planar navigation base source lock mismatch' >&2; exit 2; }; \
      test -f /opt/actucore_navigation_ws/install/setup.bash; \
    else \
      source /etc/os-release; \
      for suite in "${VERSION_CODENAME}" "${VERSION_CODENAME}-updates" "${VERSION_CODENAME}-security"; do \
        printf 'deb https://%s/ubuntu-ports %s main restricted universe multiverse\n' \
          "${APT_MIRROR:-ports.ubuntu.com}" "$suite"; \
      done > /tmp/actucore-ubuntu.list; \
      apt_args=(-o Dir::Etc::sourcelist=/tmp/actucore-ubuntu.list -o Dir::Etc::sourceparts=- \
                -o APT::Update::Error-Mode=any -o Acquire::Retries=3); \
      apt-get "${apt_args[@]}" update && \
      apt-get "${apt_args[@]}" install -y --no-install-recommends \
        build-essential cmake git pkg-config libboost-program-options-dev libeigen3-dev \
        libceres-dev libsuitesparse-dev liblapack-dev libtbb-dev qtbase5-dev \
        libgraphicsmagick++1-dev python3-pil && \
      rm -rf /var/lib/apt/lists/* && rm /tmp/actucore-ubuntu.list && \
      pip3 install --no-cache-dir -i ${PYPI_MIRROR} colcon-common-extensions && \
      pip3 install --no-cache-dir -i ${PYPI_MIRROR} "empy<4" && \
      bash /tmp/planar-build/build-dependencies.sh; \
    fi

# ── audio_msgs ROS2 package (Humble already in base) ──────────────
COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && \
    source /opt/actucore_navigation_ws/install/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release

# ── Python deps ────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    pyyaml requests

# ── Application code ───────────────────────────────────────────────
WORKDIR /work
COPY actucore/main.py     /work/main.py
COPY actucore/plugins/    /work/plugins/
COPY actucore/config.yaml /work/config.yaml
# Atomic-write stdout guard. The build context is the repo root, so this reuses
# perception's copy instead of adding a fourth one to keep in sync — see the
# DUPLICATION note in perception/utils/logsafe.py.
COPY perception/utils/logsafe.py /work/logsafe.py
# Agent Core reads /deploy/service.yml out of the image to merge the compose
# fragment — dropping this COPY silently falls back to the legacy docker-run path.
COPY actucore/deploy/     /deploy/
COPY actucore/tests/      /work/tests/
COPY actucore/Dockerfile.jetson /work/Dockerfile.jetson

RUN source /ros_ws/install/setup.bash && \
    python3 -m unittest discover -s /work/tests -p test_planar_navigation.py -v && \
    python3 -c 'from plugins.planar_navigation.runtime import Runtime; from nav2_msgs.action import NavigateToPose; from slam_toolbox.srv import SaveMap'

EXPOSE 15730

# 确保 ROS2 Python 包始终在 PYTHONPATH 中（不依赖 source setup.bash）
RUN python_site="$(python3 -c 'import site; print(site.getsitepackages()[0])')" && \
    find /ros_ws/install /opt/actucore_navigation_ws/install /opt/ros/humble/install \
      -name "site-packages" -type d > "${python_site}/ros_ws.pth"

# ROS2 shared libraries（audio_msgs .so 等）
ENV LD_LIBRARY_PATH="/ros_ws/install/audio_msgs/lib:/opt/actucore_navigation_ws/install/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/ros_ws/install/audio_msgs:/opt/actucore_navigation_ws/install:/opt/ros/humble/install"

ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_DOMAIN_ID=42

CMD ["/bin/bash", "-c", \
    "export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1 && \
     source /opt/ros/humble/install/setup.bash && \
     source /opt/actucore_navigation_ws/install/setup.bash && \
     source /ros_ws/install/setup.bash && \
     python3 /work/main.py"]
